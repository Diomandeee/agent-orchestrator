#!/usr/bin/env python3
"""Codex host shim for UCTM Studio. Never places the provider key in Codex."""
import hashlib
import os
import shutil
import sys
from pathlib import Path

HOST = "/Users/mohameddiomande/.local/bin/codex"
ISOLATED_HOME = "/Users/mohameddiomande/.ao/uctm-studio/home"
ISOLATED_SKILLS = Path(ISOLATED_HOME, ".codex", "skills")
CODEX_HOME = "/Users/mohameddiomande/.ao/uctm-studio/codex"
PROXY_TOKEN = Path("/Users/mohameddiomande/.ao/uctm-studio/proxy-token")
EXPECTED_SHA256 = "9280c0754e8f1f6b72f495d30c8c82a006dbc4995bf0492916fa0901f6bfd1f9"

# hashlib.file_digest below needs >= 3.11. The shebang can resolve to the
# system 3.9 interpreter whenever /usr/bin precedes Homebrew on PATH, which is
# exactly the PATH an AO-spawned child inherits. Re-exec under a supported
# interpreter, and otherwise fail with an explicit version error instead of
# the generic host-unavailable message.
MIN_PYTHON = (3, 11)
PYTHON_CANDIDATES = (
    "/opt/homebrew/bin/python3.14",
    "/opt/homebrew/bin/python3.13",
    "/opt/homebrew/bin/python3.12",
    "/opt/homebrew/bin/python3.11",
    "/usr/local/bin/python3.14",
    "/usr/local/bin/python3.13",
    "/usr/local/bin/python3.12",
    "/usr/local/bin/python3.11",
)
REEXEC_MARKER = "UCTM_CODEX_SHIM_INTERPRETER"


def ensure_supported_interpreter():
    if sys.version_info >= MIN_PYTHON or os.environ.get(REEXEC_MARKER):
        return
    for candidate in PYTHON_CANDIDATES:
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            env = dict(os.environ)
            env[REEXEC_MARKER] = candidate
            os.execve(candidate, [candidate, os.path.abspath(__file__), *sys.argv[1:]], env)


def real_home():
    """The user's home from the account database, ignoring a rewritten $HOME.

    The daemon may launch this shim with $HOME already pointed at the isolated
    home; only the passwd database still knows the real one.
    """
    try:
        import pwd
    except ImportError:
        return None
    try:
        return pwd.getpwuid(os.getuid()).pw_dir
    except (KeyError, OSError):
        return None


def real_skills_dir():
    home = real_home()
    if not home:
        return None
    candidate = Path(home, ".codex", "skills")
    return candidate if candidate.is_dir() else None


def seed_isolated_skills(dest=ISOLATED_SKILLS, src=None):
    """Snapshot the user's real skills into the isolated home.

    Sessions run with HOME rewritten to ISOLATED_HOME, so `~/.codex/skills`
    resolves to a near-empty directory and every chain written with `~` fails
    silently (the auditor's `--promotion-plan swiftui-pro` missed a skill that
    exists). A snapshot copy -- not a symlink -- keeps session writes
    (reports, caches) inside the isolated home instead of polluting the real
    tree, and overlay semantics never delete anything a session created: a
    skill deleted from the real home may linger here until the isolated
    directory is cleared by hand. Non-fatal: on any failure the session still
    starts, with a named warning on stderr.
    """
    if src is None:
        src = real_skills_dir()
    if src is None:
        print("uctm_codex_skills_seed_skipped: no readable real skills directory",
              file=sys.stderr)
        return False
    try:
        dest.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    except OSError as error:
        print(f"uctm_codex_skills_seed_failed: {error}"[:300], file=sys.stderr)
        return False
    if dest.is_symlink():
        # A leftover link would redirect the copy into the real tree.
        try:
            dest.unlink()
        except OSError as error:
            print(f"uctm_codex_skills_seed_failed: {error}"[:300], file=sys.stderr)
            return False
    tmp = dest.with_name(f".skills-seed-{os.getpid()}")
    shutil.rmtree(tmp, ignore_errors=True)
    try:
        shutil.copytree(src, tmp, symlinks=True)
    except OSError as error:
        print(f"uctm_codex_skills_seed_failed: copy: {error}"[:300], file=sys.stderr)
        shutil.rmtree(tmp, ignore_errors=True)
        return False
    try:
        if not dest.is_dir() or not any(dest.iterdir()):
            # Atomic swap: concurrent spawns and readers never see a partial tree.
            os.replace(tmp, dest)
        else:
            # Non-empty destination (a previous session wrote here): overlay the
            # real skills rather than deleting a tree another live session may
            # be reading.
            for entry in tmp.iterdir():
                target = dest / entry.name
                if entry.is_dir() and not entry.is_symlink():
                    shutil.copytree(entry, target, symlinks=True, dirs_exist_ok=True)
                else:
                    shutil.copy2(entry, target)
        shutil.rmtree(tmp, ignore_errors=True)
    except OSError as error:
        print(f"uctm_codex_skills_seed_failed: install: {error}"[:300], file=sys.stderr)
        shutil.rmtree(tmp, ignore_errors=True)
        return False
    return True


def main():
    ensure_supported_interpreter()
    if sys.version_info < MIN_PYTHON:
        print("uctm_codex_python_too_old: need python>=3.11 for hashlib.file_digest, "
              "found {} at {}".format(sys.version.split()[0], sys.executable), file=sys.stderr)
        return 3
    with open(HOST, "rb") as host_binary:
        actual = hashlib.file_digest(host_binary, "sha256").hexdigest()
    if actual != EXPECTED_SHA256:
        print("uctm_codex_host_hash_mismatch", file=sys.stderr)
        return 3
    if os.environ.get("CODEX_HOME") != CODEX_HOME:
        print("uctm_codex_home_mismatch", file=sys.stderr)
        return 3
    config = Path(CODEX_HOME, "config.toml").read_text()
    if ('model_provider = "deepseek"' not in config or 'wire_api = "responses"' not in config
            or 'env_key = "UCTM_PROXY_TOKEN"' not in config
            or 'base_url = "http://127.0.0.1:8769"' not in config):
        print("uctm_codex_provider_mismatch", file=sys.stderr)
        return 3
    # Version/help probes never need a credential.
    if not any(a in ("--version", "--help", "-h") for a in sys.argv[1:]):
        stat = PROXY_TOKEN.stat()
        if stat.st_uid != os.getuid() or stat.st_mode & 0o077:
            print("uctm_proxy_token_permissions_invalid", file=sys.stderr)
            return 2
        token = PROXY_TOKEN.read_text().strip()
        if len(token) < 32:
            print("uctm_proxy_token_unavailable", file=sys.stderr)
            return 2
        # AO's Codex auth probe only understands `codex login status`. This
        # host uses a local authenticated transport, not a Codex account login.
        if sys.argv[1:] == ["login", "status"]:
            print("Logged in via configured UCTM provider transport")
            return 0
        os.environ.pop("DEEPSEEK_API_KEY", None)
        os.environ.pop("OPENAI_API_KEY", None)
        os.environ["UCTM_PROXY_TOKEN"] = token
    os.makedirs(ISOLATED_HOME, mode=0o700, exist_ok=True)
    # Non-fatal by design: a failed seed still starts the session, with the
    # reason on stderr for the launcher log.
    seed_isolated_skills()
    os.environ["HOME"] = ISOLATED_HOME
    # Name the real home to everything this shim spawns. The rewrite above is
    # right for the session and wrong for every `~` path a child builds, and
    # three separate files had already grown private copies of that reasoning
    # before any child could simply ask for the answer. Non-fatal by design: a
    # session without it behaves exactly as before, rather than failing here.
    estate = real_home()
    if estate:
        os.environ["UCTM_ESTATE_HOME"] = estate
    os.execv(HOST, [HOST, *sys.argv[1:]])


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exception:
        print("uctm_codex_host_unavailable: {}: {}".format(
            type(exception).__name__, exception)[:300], file=sys.stderr)
        raise SystemExit(3)
